 "audio": {
  "l07-01": {
   "voice": "tanya",
   "text": "Hello, Diego? I'm Tanya, the Chief Officer. Can I come in?",
   "es": "Hola, ¿Diego? Soy Tanya, la Primer Oficial. ¿Puedo pasar?"
  },
  "l07-02": {
   "voice": "diego",
   "text": "Yes, of course. Nice to meet you.",
   "es": "Sí, claro. Mucho gusto."
  },
  "l07-03": {
   "voice": "tanya",
   "text": "Nice to meet you too. OK, your safety kit. First, your lifejacket. Where is it?",
   "es": "Igualmente. Bueno, tu equipo de seguridad. Primero, tu chaleco salvavidas. ¿Dónde está?"
  },
  "l07-04": {
   "voice": "diego",
   "text": "Er… on the wardrobe?",
   "es": "Eh… ¿sobre el placard?"
  },
  "l07-05": {
   "voice": "tanya",
   "text": "Not on the wardrobe. In the wardrobe. Look, here, on the top shelf.",
   "es": "Sobre el placard no. Adentro del placard. Mirá, acá, en el estante de arriba."
  },
  "l07-06": {
   "voice": "diego",
   "text": "In the wardrobe. Got it.",
   "es": "Adentro del placard. Entendido."
  },
  "l07-07": {
   "voice": "tanya",
   "text": "And this orange bag, under the bunk, is your immersion suit.",
   "es": "Y este bolso naranja, debajo de la cucheta, es tu traje de inmersión."
  },
  "l07-08": {
   "voice": "diego",
   "text": "Sorry, can you say that again? Immersion…?",
   "es": "Perdón, ¿lo podés repetir? ¿Inmersión…?"
  },
  "l07-09": {
   "voice": "tanya",
   "text": "Immersion suit. For cold water. Now, behind the door, there's your muster card. Read it to me.",
   "es": "Traje de inmersión. Para el agua fría. Ahora, detrás de la puerta está tu tarjeta de zafarrancho. Leémela."
  },
  "l07-10": {
   "voice": "diego",
   "text": "Muster station B. Boat deck, port side. Lifeboat number two.",
   "es": "Estación de reunión B. Cubierta de botes, babor. Bote salvavidas número dos."
  },
  "l07-11": {
   "voice": "tanya",
   "text": "Good. And your escape route is the stairs next to the laundry. Not the lift.",
   "es": "Bien. Y tu vía de escape es la escalera al lado del lavadero. No el ascensor."
  },
  "l07-12": {
   "voice": "diego",
   "text": "The stairs next to the laundry. OK.",
   "es": "La escalera al lado del lavadero. Okey."
  },
  "l07-13": {
   "voice": "tanya",
   "text": "Perfect. Tomorrow morning we have a drill. See you at your muster station.",
   "es": "Perfecto. Mañana a la mañana tenemos un simulacro. Nos vemos en tu estación de reunión."
  },
  "l07-14": {
   "voice": "diego",
   "text": "Thank you. See you tomorrow.",
   "es": "Gracias. Hasta mañana."
  },
