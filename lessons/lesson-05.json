 "audio": {
  "l05-01": {
   "voice": "james",
   "text": "This is the VHF. In port we listen on channel twelve. Can you take a message for me? I need to go down to the deck.",
   "es": "Este es el VHF. En puerto escuchamos el canal doce. ¿Me tomás un mensaje? Tengo que bajar a cubierta."
  },
  "l05-02": {
   "voice": "diego",
   "text": "Sure. What do I write?",
   "es": "Claro. ¿Qué anoto?"
  },
  "l05-03": {
   "voice": "james",
   "text": "Who calls, the time and the message. If you need to spell, use the phonetic alphabet. Back in five minutes.",
   "es": "Quién llama, la hora y el mensaje. Si tenés que deletrear, usá el alfabeto fonético. Vuelvo en cinco minutos."
  },
  "l05-04": {
   "voice": "terminal",
   "radio": true,
   "text": "LNG Horizon, LNG Horizon, this is Houston Terminal. Over.",
   "es": "LNG Horizon, LNG Horizon, aquí Houston Terminal. Cambio."
  },
  "l05-05": {
   "voice": "diego",
   "text": "Houston Terminal, this is LNG Horizon. Go ahead. Over.",
   "es": "Houston Terminal, aquí LNG Horizon. Adelante. Cambio."
  },
  "l05-06": {
   "voice": "terminal",
   "radio": true,
   "text": "LNG Horizon, confirm your call sign. Over.",
   "es": "LNG Horizon, confirme su distintivo de llamada. Cambio."
  },
  "l05-07": {
   "voice": "diego",
   "text": "Our call sign is Charlie Six X-ray Yankee Seven. Over.",
   "es": "Nuestro distintivo es Charlie Six X-ray Yankee Seven. Cambio."
  },
  "l05-08": {
   "voice": "terminal",
   "radio": true,
   "text": "Thank you. The pilot boards tomorrow at one seven zero zero. I say again, one seven zero zero. Over.",
   "es": "Gracias. El práctico sube mañana a las diecisiete horas. Repito, uno siete cero cero. Cambio."
  },
  "l05-09": {
   "voice": "diego",
   "text": "One seven zero zero. Received. Over.",
   "es": "Uno siete cero cero. Recibido. Cambio."
  },
  "l05-10": {
   "voice": "terminal",
   "radio": true,
   "text": "Also, call the gas inspector, Mister Kowalski. I spell: Kilo, Oscar, Whiskey, Alfa,| Lima, Sierra, Kilo, India. Over.",
   "es": "Además, llamen al inspector de gas, el señor Kowalski. Deletreo: K-O-W-A-L-S-K-I. Cambio."
  },
  "l05-11": {
   "voice": "diego",
   "text": "Say again the last part, please. Over.",
   "es": "Repita la última parte, por favor. Cambio."
  },
  "l05-12": {
   "voice": "terminal",
   "radio": true,
   "text": "Lima, Sierra, Kilo, India. Kowalski. Over.",
   "es": "L-S-K-I. Kowalski. Cambio."
  },
  "l05-13": {
   "voice": "diego",
   "text": "Kowalski. Received. LNG Horizon, out.",
   "es": "Kowalski. Recibido. LNG Horizon, corto."
  },
  "l05-14": {
   "voice": "james",
   "text": "I'm back. Any calls?",
   "es": "Volví. ¿Alguna llamada?"
  },
  "l05-15": {
   "voice": "diego",
   "text": "Yes. Houston Terminal, at fourteen ten. The pilot boards tomorrow at seventeen hundred, and please call Mister Kowalski, the gas inspector.",
   "es": "Sí. Houston Terminal, a las catorce y diez. El práctico sube mañana a las diecisiete, y por favor llamen al señor Kowalski, el inspector de gas."
  },
  "l05-16": {
   "voice": "james",
   "text": "Perfect. You're a radio operator already!",
   "es": "Perfecto. ¡Ya sos un operador de radio!"
  },
