 "audio": {
  "l08-01": {
   "voice": "mario",
   "text": "Ah, the new cadet! Come, come. Sit down.",
   "es": "¡Ah, el cadete nuevo! Vení, vení. Sentate."
  },
  "l08-02": {
   "voice": "diego",
   "text": "Good evening. Sorry, am I late?",
   "es": "Buenas noches. Perdón, ¿llego tarde?"
  },
  "l08-03": {
   "voice": "mario",
   "text": "A little! Dinner is from seventeen thirty to eighteen fifteen. But I kept a plate for you. Chicken adobo.",
   "es": "¡Un poco! La cena es de diecisiete treinta a dieciocho quince. Pero te guardé un plato. Pollo adobo."
  },
  "l08-04": {
   "voice": "diego",
   "text": "Thank you very much. What time is breakfast?",
   "es": "Muchas gracias. ¿A qué hora es el desayuno?"
  },
  "l08-05": {
   "voice": "mario",
   "text": "Breakfast is from zero seven thirty to zero eight fifteen.",
   "es": "El desayuno es de cero siete treinta a cero ocho quince."
  },
  "l08-06": {
   "voice": "diego",
   "text": "Seven and a half?",
   "es": "¿Siete y media?"
  },
  "l08-07": {
   "voice": "rolando",
   "text": "Zero seven thirty, cadet! On board we use the twenty-four-hour clock.",
   "es": "¡Cero siete treinta, cadete! A bordo usamos el reloj de veinticuatro horas."
  },
  "l08-08": {
   "voice": "diego",
   "text": "Zero seven thirty. Got it. And lunch?",
   "es": "Cero siete treinta. Entendido. ¿Y el almuerzo?"
  },
  "l08-09": {
   "voice": "mario",
   "text": "Lunch is at eleven thirty. And coffee break is at ten hundred and fifteen hundred.",
   "es": "El almuerzo es a las once treinta. Y el café es a las diez cero cero y a las quince cero cero."
  },
  "l08-10": {
   "voice": "diego",
   "text": "Could you pass the salt, please?",
   "es": "¿Me pasás la sal, por favor?"
  },
  "l08-11": {
   "voice": "rolando",
   "text": "Here you are.",
   "es": "Acá tenés."
  },
  "l08-12": {
   "voice": "mario",
   "text": "And if you're on watch at dinner time, tell me. I keep a plate for you.",
   "es": "Y si estás de guardia a la hora de la cena, avisame. Te guardo un plato."
  },
  "l08-13": {
   "voice": "diego",
   "text": "Thanks, Mario. Can I have some more rice?",
   "es": "Gracias, Mario. ¿Me das un poco más de arroz?"
  },
  "l08-14": {
   "voice": "mario",
   "text": "Of course! And all the times are on the notice board, next to the door.",
   "es": "¡Claro! Y todos los horarios están en la cartelera, al lado de la puerta."
  },
