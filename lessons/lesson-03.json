{
  "n": 3,
  "module": 1,
  "title": "Decks & spaces",
  "place": "Day 1 · 09:30 · Houston, accommodation",
  "goal": "Say where the spaces are: which deck, up or down.",
  "images": {"hero": "img/l03/hero.jpg", "scene": "img/l03/scene.jpg"},

  "audio": {
    "l03-01": {"voice": "rolando", "text": "OK, let's go inside. This is the main deck level. The galley is here, and the laundry is next to it.", "es": "Bueno, entremos. Este es el nivel de la cubierta principal. La cocina está acá, y la lavandería al lado."},
    "l03-02": {"voice": "diego",   "text": "Where's the mess room?", "es": "¿Dónde está el comedor?"},
    "l03-03": {"voice": "rolando", "text": "One deck up, on A-deck. There are two mess rooms: one for the officers and one for the crew.", "es": "Una cubierta más arriba, en la cubierta A. Hay dos comedores: uno para los oficiales y uno para la tripulación."},
    "l03-04": {"voice": "diego",   "text": "And my cabin?", "es": "¿Y mi camarote?"},
    "l03-05": {"voice": "rolando", "text": "Your cabin is on C-deck. That's three decks up.", "es": "Tu camarote está en la cubierta C. Son tres cubiertas más arriba."},
    "l03-06": {"voice": "diego",   "text": "Three decks with this bag! Is there a lift?", "es": "¡Tres cubiertas con este bolso! ¿Hay ascensor?"},
    "l03-07": {"voice": "rolando", "text": "Yes, there's a lift. But we usually take the stairs. Good exercise!", "es": "Sí, hay ascensor. Pero normalmente usamos las escaleras. ¡Buen ejercicio!"},
    "l03-08": {"voice": "diego",   "text": "And the engine room? Is it down there?", "es": "¿Y la sala de máquinas? ¿Está ahí abajo?"},
    "l03-09": {"voice": "rolando", "text": "Yes. The engine room is below the main deck. That's Marek's world, the Chief Engineer.", "es": "Sí. La sala de máquinas está debajo de la cubierta principal. Es el mundo de Marek, el Jefe de Máquinas."},
    "l03-10": {"voice": "diego",   "text": "So the bridge is at the very top.", "es": "Entonces el puente está arriba de todo."},
    "l03-11": {"voice": "rolando", "text": "That's right. Five decks up. Come on, let's take your bag to your cabin.", "es": "Así es. Cinco cubiertas más arriba. Vamos, llevemos tu bolso al camarote."},

    "w-deck":    {"voice": "model", "text": "deck"},
    "w-cabin":   {"voice": "model", "text": "cabin"},
    "w-mess":    {"voice": "model", "text": "mess room"},
    "w-galley":  {"voice": "model", "text": "galley"},
    "w-laundry": {"voice": "model", "text": "laundry"},
    "w-engine":  {"voice": "model", "text": "engine room"},
    "w-stairs":  {"voice": "model", "text": "stairs"},
    "w-lift":    {"voice": "model", "text": "lift"},

    "x-deck":    {"voice": "model", "text": "My cabin is on C-deck.", "es": "Mi camarote está en la cubierta C."},
    "x-cabin":   {"voice": "model", "text": "Your cabin is three decks up.", "es": "Tu camarote está tres cubiertas más arriba."},
    "x-mess":    {"voice": "model", "text": "We eat in the mess room.", "es": "Comemos en el comedor."},
    "x-galley":  {"voice": "model", "text": "The cook is in the galley.", "es": "El cocinero está en la cocina."},
    "x-laundry": {"voice": "model", "text": "The laundry is next to the galley.", "es": "La lavandería está al lado de la cocina."},
    "x-engine":  {"voice": "model", "text": "The engine room is below the main deck.", "es": "La sala de máquinas está debajo de la cubierta principal."},
    "x-stairs":  {"voice": "model", "text": "Take the stairs.", "es": "Tomá las escaleras."},
    "x-lift":    {"voice": "model", "text": "There's a lift.", "es": "Hay un ascensor."},

    "p-where":   {"voice": "model", "text": "Where's the mess room?", "es": "¿Dónde está el comedor?"},
    "p-up":      {"voice": "model", "text": "It's one deck up.", "es": "Está una cubierta más arriba."},
    "p-down":    {"voice": "model", "text": "It's two decks down.", "es": "Está dos cubiertas más abajo."},
    "p-lift":    {"voice": "model", "text": "Is there a lift?", "es": "¿Hay ascensor?"},

    "c-show-laundry": {"voice": "rolando", "text": "Show me the laundry."},
    "c-where-galley": {"voice": "rolando", "text": "Where's the galley?"},
    "c-show-engine":  {"voice": "rolando", "text": "Show me the engine room."},
    "c-where-mess":   {"voice": "rolando", "text": "Where's the mess room?"},
    "c-where-cabin":  {"voice": "rolando", "text": "Where's your cabin?"},
    "c-office":       {"voice": "tanya",   "text": "The ship's office is on A-deck."},
    "c-show-lift":    {"voice": "tanya",   "text": "Show me the lift."},
    "c-show-stairs":  {"voice": "tanya",   "text": "Where are the stairs?"},
    "c-how-up":       {"voice": "tanya",   "text": "How many decks up is the bridge?"},
    "c-where-er":     {"voice": "tanya",   "text": "Where's the engine room?"},
    "c-hospital":     {"voice": "tanya",   "text": "The hospital is on B-deck, two decks up."},

    "m-two-mess":   {"voice": "model", "text": "There are two mess rooms.", "es": "Hay dos comedores."},
    "m-three-up":   {"voice": "model", "text": "My cabin is three decks up.", "es": "Mi camarote está tres cubiertas más arriba."},
    "m-cdeck":      {"voice": "model", "text": "It's on C-deck.", "es": "Está en la cubierta C."},
    "m-below":      {"voice": "model", "text": "It's below the main deck.", "es": "Está debajo de la cubierta principal."},
    "m-five-up":    {"voice": "model", "text": "It's five decks up.", "es": "Está cinco cubiertas más arriba."},
    "m-galley-md":  {"voice": "model", "text": "It's on the main deck.", "es": "Está en la cubierta principal."}
  },

  "dialogue": ["l03-01","l03-02","l03-03","l03-04","l03-05","l03-06","l03-07","l03-08","l03-09","l03-10","l03-11"],

