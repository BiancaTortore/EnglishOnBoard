  "docs": {
    "directory": {
      "kind": "form",
      "title": "ACCOMMODATION PLAN",
      "subtitle": "M/V LNG HORIZON",
      "table": {
        "head": ["DECK", "SPACES"],
        "rows": [
          ["BRIDGE", "Wheelhouse, chart area"],
          ["D-DECK", "Master, Chief Engineer, Chief Officer"],
          ["C-DECK", "Officers' cabins, cadet cabin"],
          ["B-DECK", "Crew cabins, hospital"],
          ["A-DECK", "Officers' mess, crew mess, ship's office"],
          ["MAIN DECK", "Galley, laundry, changing room"],
          ["BELOW MAIN DECK", "Engine room, engine control room"]
        ]
      }
    }
  },

  "sessions": [
    {"id": "listen", "title": "Listen: going inside", "skill": "Listening", "min": 4, "screens": [
      {"type": "intro", "image": "img/l03/scene.jpg", "kicker": "Day 1 · 09:30 · Houston", "title": "Inside the accommodation",
       "body": "Rolando takes Diego inside. Diego wants to know where everything is, and how far he has to carry his bag. Listen first, one piece at a time.",
       "es": "Escuchá primero. El texto está escondido a propósito."},
      {"type": "listen", "audio": ["l03-01"], "q": "What is next to the galley?",
       "opts": ["The laundry", "The mess room", "The engine room"], "a": 0, "why": "\"…and the laundry is next to it.\""},
      {"type": "listen", "audio": ["l03-02","l03-03"], "q": "How many mess rooms are there?",
       "opts": ["Two", "One", "Three"], "a": 0, "why": "\"There are two mess rooms.\""},
      {"type": "listen", "audio": ["l03-04","l03-05"], "q": "Where is Diego's cabin?",
       "opts": ["On C-deck, three decks up", "On A-deck, one deck up", "On the main deck"], "a": 0},
      {"type": "listen", "audio": ["l03-06","l03-07"], "q": "Is there a lift?",
       "opts": ["Yes, but they usually take the stairs", "No, only stairs", "Yes, and they always use it"], "a": 0},
      {"type": "listen", "audio": ["l03-08","l03-09"], "q": "Where is the engine room?",
       "opts": ["Below the main deck", "Next to the galley", "On A-deck"], "a": 0},
      {"type": "listen", "audio": ["l03-10","l03-11"], "q": "How many decks up is the bridge?",
       "opts": ["Five", "Three", "Two"], "a": 0, "why": "\"Five decks up.\""},
      {"type": "dialogue", "title": "Now the whole walk", "body": "Play it again. Open the text and the Spanish if you want them."}
    ]},

    {"id": "words", "title": "Find the spaces", "skill": "Vocabulary", "min": 5, "screens": [
      {"type": "plate", "title": "Tap every number", "body": "The accommodation, cut open. The main deck is at the bottom."},
      {"type": "card", "word": "deck"},
      {"type": "card", "word": "cabin"},
      {"type": "card", "word": "mess"},
      {"type": "card", "word": "galley"},
      {"type": "tip", "tag": "Spanish speaker alert", "title": "On a ship, a floor is a deck",
       "paras": ["The levels of a ship are <b>decks</b>, not floors. Say <b>on C-deck</b>, <b>two decks up</b>.",
                 "And the kitchen is the <b>galley</b>. Kitchen is for houses."],
       "avoid": "my cabin is on the third floor"},
      {"type": "card", "word": "laundry"},
      {"type": "card", "word": "engine"},
      {"type": "card", "word": "stairs"},
      {"type": "card", "word": "lift"},
      {"type": "tap", "audio": "c-show-laundry", "a": "laundry"},
      {"type": "tap", "audio": "c-show-engine", "a": "engine"},
      {"type": "tap", "audio": "c-show-stairs", "a": "stairs"},
      {"type": "match", "title": "Match the pairs", "pairs": [["galley","cocina"],["mess room","comedor"],["cabin","camarote"],["engine room","sala de máquinas"],["lift","ascensor"]]}
    ]},

    {"id": "phrases", "title": "One deck up", "skill": "Phrases", "min": 4, "screens": [
      {"type": "tip", "tag": "Useful language", "title": "Asking where things are",
       "list": [["Where's the mess room?","¿Dónde está el comedor?","p-where"],["It's one deck up.","Está una cubierta más arriba.","p-up"],["It's two decks down.","Está dos cubiertas más abajo.","p-down"],["Is there a lift?","¿Hay ascensor?","p-lift"]]},
      {"type": "tip", "tag": "Language focus", "title": "\"Hay\" is there is / there are",
       "steps": [["One","There's a lift. · Is there a lift?"],["More","There are two mess rooms."],["No","There isn't a gym."]],
       "avoid": "Have a lift? · There is two mess rooms."},
      {"type": "choice", "q": "There ___ two mess rooms.", "opts": ["are","is","have"], "a": 0, "why": "Two = there are."},
      {"type": "choice", "q": "___ there a lift?", "opts": ["Is","Are","Have"], "a": 0, "why": "One lift = is there."},
      {"type": "tip", "tag": "Language focus", "title": "Up, down and below",
       "steps": [["Up","one deck up · three decks up"],["Down","two decks down"],["Under","below the main deck"]],
       "paras": ["The number comes first, then <b>deck</b> or <b>decks</b>, then <b>up</b> or <b>down</b>."],
       "avoid": "three deck up · up three decks"},
      {"type": "choice", "q": "My cabin is three ___ up.", "opts": ["decks","deck","floors"], "a": 0},
      {"type": "build", "cue": "c-where-mess", "q": "Answer Rolando.",
       "a": ["It's","one","deck","up."], "extra": ["floor","decks","is"]},
      {"type": "build", "situation": "You have a heavy bag and you're on the main deck.", "q": "Ask if there's a lift.",
       "a": ["Is","there","a","lift?"], "extra": ["have","are","the"]},
      {"type": "choice", "cue": "c-office", "q": "Which deck is the ship's office on?", "opts": ["A-deck","C-deck","The main deck"], "a": 0}
    ]},

    {"id": "read", "title": "Read the accommodation plan", "skill": "Reading", "min": 3, "screens": [
      {"type": "doc", "doc": "directory", "q": "Where is the hospital?", "opts": ["B-deck","D-deck","Main deck"], "a": 0},
      {"type": "doc", "doc": "directory", "q": "Which deck is the Master's cabin on?", "opts": ["D-deck","C-deck","A-deck"], "a": 0},
      {"type": "doc", "doc": "directory", "q": "Where can Diego eat?", "opts": ["A-deck","B-deck","The bridge"], "a": 0, "why": "The mess rooms are on A-deck."},
      {"type": "doc", "doc": "directory", "q": "The engine control room is…", "opts": ["below the main deck","on the bridge","next to the hospital"], "a": 0}
    ]},

    {"id": "speak", "title": "Say where it is", "skill": "Speaking", "min": 4, "screens": [
      {"type": "intro", "kicker": "Speaking", "title": "Up and down, out loud",
       "body": "Listen, say it, check it. Remember: deck, not floor.",
       "es": "Acordate: deck, no floor.", "button": "Start"},
      {"type": "shadow", "model": "m-two-mess"},
      {"type": "shadow", "model": "m-three-up"},
      {"type": "shadow", "model": "p-lift"},
      {"type": "role", "cue": "c-where-cabin", "task": "Answer: on C-deck.", "model": "m-cdeck",
       "accept": ["On C-deck.","It's on C deck.","My cabin is on C-deck.","It's three decks up."]},
      {"type": "role", "cue": "c-where-er", "task": "Answer: below the main deck.", "model": "m-below",
       "accept": ["Below the main deck.","The engine room is below the main deck."]},
      {"type": "role", "cue": "c-how-up", "task": "Answer: five.", "model": "m-five-up",
       "accept": ["Five decks up.","Five.","The bridge is five decks up."]},
      {"type": "role", "situation": "You want to know where everyone eats.", "task": "Ask where the mess room is.", "model": "p-where",
       "accept": ["Where is the mess room?","Where's the mess room, please?"]}
    ]},

    {"id": "check", "title": "Lesson check", "skill": "Review", "min": 4, "screens": [
      {"type": "type", "audio": "w-galley", "q": "Type what you hear.", "accept": ["galley"]},
      {"type": "type", "audio": "w-stairs", "q": "Type what you hear.", "accept": ["stairs"]},
      {"type": "tap", "audio": "c-show-lift", "a": "lift"},
      {"type": "tap", "audio": "c-show-laundry", "a": "laundry"},
      {"type": "listen", "audio": ["c-hospital"], "q": "Where is the hospital?", "opts": ["B-deck","A-deck","D-deck"], "a": 0},
      {"type": "choice", "q": "\"la cocina\" of a ship in English:", "opts": ["the galley","the kitchen","the mess room"], "a": 0},
      {"type": "choice", "q": "The bridge is five ___ up.", "opts": ["decks","floors","deck"], "a": 0},
      {"type": "build", "cue": "c-where-galley", "q": "Answer: on the main deck.", "a": ["It's","on","the","main","deck."], "extra": ["in","floor"]},
