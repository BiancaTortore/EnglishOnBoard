 "audio": {
  "l15-01": {
   "voice": "diego",
   "text": "Chief Officer! The wind is increasing. And there's a dark cloud ahead.",
   "es": "¡Primer Oficial! El viento está aumentando. Y hay una nube oscura adelante."
  },
  "l15-02": {
   "pause": 600,
   "voice": "tanya",
   "text": "Let me see… Yes, that's a squall. Rain and strong gusts. What's the barometer?",
   "es": "A ver… Sí, es un chubasco. Lluvia y rachas fuertes. ¿Qué marca el barómetro?"
  },
  "l15-03": {
   "pause": 900,
   "voice": "diego",
   "text": "One thousand and six. It's falling.",
   "es": "Mil seis. Está bajando."
  },
  "l15-04": {
   "voice": "tanya",
   "text": "Falling fast. That's the front. And the wind now?",
   "es": "Bajando rápido. Es el frente. ¿Y el viento ahora?"
  },
  "l15-05": {
   "voice": "diego",
   "text": "North-west, force six, I think.",
   "es": "Del noroeste, fuerza seis, creo."
  },
  "l15-06": {
   "voice": "tanya",
   "text": "Good. And the sea?",
   "es": "Bien. ¿Y el mar?"
  },
  "l15-07": {
   "voice": "diego",
   "text": "The sea is rough. And there's a long swell from the north-west.",
   "es": "El mar está agitado. Y hay oleaje largo del noroeste."
  },
  "l15-08": {
   "voice": "tanya",
   "text": "Visibility?",
   "es": "¿Visibilidad?"
  },
  "l15-09": {
   "voice": "diego",
   "text": "Good now. Five miles, maybe. But in the rain, much less.",
   "es": "Buena ahora. Cinco millas, quizás. Pero con la lluvia, mucho menos."
  },
  "l15-10": {
   "pause": 500,
   "voice": "tanya",
   "text": "Right. Close the door of the bridge wing and write it in the log: zero six thirty, wind north-west six, sea rough, barometer one thousand and six, falling.",
   "es": "Bien. Cerrá la puerta del alerón y anotalo en el diario: cero seis treinta, viento noroeste seis, mar agitado, barómetro mil seis, bajando."
  },
  "l15-11": {
   "voice": "diego",
   "text": "Zero six thirty, wind north-west six…",
   "es": "Cero seis treinta, viento noroeste seis…"
  },
  "l15-12": {
   "pause": 1500,
   "voice": "tanya",
   "text": "Here comes the rain. Diego, keep a good lookout and report the visibility.",
   "es": "Ahí viene la lluvia. Diego, mantené buena vigía y reportá la visibilidad."
  },
  "l15-13": {
   "pause": 1300,
   "voice": "diego",
   "text": "Visibility about one mile now!",
   "es": "¡Visibilidad de una milla ahora!"
  },
  "l15-14": {
   "voice": "tanya",
   "text": "One mile. Standing orders: under three miles, call the Captain.",
   "es": "Una milla. Órdenes permanentes: menos de tres millas, llamar al Capitán."
  },
  "l15-15": {
   "pause": 800,
   "voice": "tanya",
   "text": "Captain, Chief Officer. We're in a squall. Visibility one mile, wind north-west seven.",
   "es": "Capitán, Primer Oficial. Estamos en un chubasco. Visibilidad una milla, viento noroeste siete."
  },
  "l15-16": {
   "pause": 700,
   "voice": "lars",
   "text": "Thank you, Tanya. I'm coming up.",
   "es": "Gracias, Tanya. Ya subo.",
