 "audio": {
  "l23-01": {
   "voice": "rolando",
   "text": "Cadet, tomorrow we have a fire drill. Today I show you the equipment in this corridor.",
   "es": "Cadete, mañana tenemos zafarrancho de incendio. Hoy te muestro los equipos de este pasillo."
  },
  "l23-02": {
   "voice": "diego",
   "text": "OK, Bosun. This red one is a fire extinguisher, right?",
   "es": "Bien, contramaestre. Este rojo es un extintor, ¿no?"
  },
  "l23-03": {
   "voice": "rolando",
   "text": "Yes, but they're all red. Look at the label. This one is water. Use water for class A fires: wood, paper, cloth.",
   "es": "Sí, pero son todos rojos. Mirá la etiqueta. Este es de agua. Usá agua para fuegos clase A: madera, papel, tela."
  },
  "l23-04": {
   "pause": 700,
   "voice": "diego",
   "text": "And this one with the blue label is foam, for oil fires.",
   "es": "Y este de etiqueta azul es de espuma, para fuegos de aceite."
  },
  "l23-05": {
   "voice": "rolando",
   "text": "No, no. Careful! Blue is dry powder. Cream is foam. Use foam for class B fires: oil and fuel.",
   "es": "No, no. ¡Cuidado! Azul es polvo químico. Crema es espuma. Usá espuma para fuegos clase B: aceite y combustible."
  },
  "l23-06": {
   "voice": "diego",
   "text": "Sorry. Blue, dry powder. Cream, foam. I'll read the label first.",
   "es": "Perdón. Azul, polvo químico. Crema, espuma. Primero voy a leer la etiqueta."
  },
  "l23-07": {
   "voice": "rolando",
   "text": "Good. And the black one is CO2. Use CO2 for electrical fires. Never water on electricity!",
   "es": "Bien. Y el negro es de CO2. Usá CO2 para fuegos eléctricos. ¡Nunca agua sobre electricidad!"
  },
  "l23-08": {
   "pause": 1200,
   "voice": "diego",
   "text": "Never water on electricity. Got it.",
   "es": "Nunca agua sobre electricidad. Entendido."
  },
  "l23-09": {
   "voice": "rolando",
   "text": "Here is the fire hydrant, and the fire hose is in this box. The hose needs two people.",
   "es": "Acá está el hidrante, y la manguera está en esta caja. La manguera necesita dos personas."
  },
  "l23-10": {
   "voice": "diego",
   "text": "And the fire blanket? I don't see one here.",
   "es": "¿Y la manta ignífuga? Acá no veo ninguna."
  },
  "l23-11": {
   "pause": 900,
   "voice": "rolando",
   "text": "It's in the galley, next to Mario's stove. It's for a small pan fire.",
   "es": "Está en la cocina, al lado del fogón de Mario. Es para un fuego chico en una sartén."
  },
  "l23-12": {
   "voice": "rolando",
   "text": "Now your job: check every extinguisher in this corridor. The needle must be in the green.",
   "es": "Ahora tu trabajo: revisá todos los extintores de este pasillo. La aguja tiene que estar en el verde."
  },
  "l23-13": {
   "voice": "diego",
   "text": "I'll check them all and tell you. Water, foam, powder, CO2.",
   "es": "Los reviso todos y te aviso. Agua, espuma, polvo, CO2."
  },
