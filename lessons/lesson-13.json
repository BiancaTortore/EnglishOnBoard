 "audio": {
  "l13-01": {
   "voice": "mateo",
   "text": "James, course one zero five, speed sixteen knots, on autopilot. No traffic close. That's all.",
   "es": "James, rumbo uno cero cinco, velocidad dieciséis nudos, en piloto automático. Sin tráfico cerca. Eso es todo."
  },
  "l13-02": {
   "voice": "james",
   "text": "Thanks, Mateo. I have the watch.",
   "es": "Gracias, Mateo. Tomo la guardia."
  },
  "l13-03": {
   "pause": 600,
   "voice": "mateo",
   "text": "Enjoy the bridge, cadet! Lunch for me now.",
   "es": "¡Disfrutá el puente, cadete! Ahora me toca almorzar."
  },
  "l13-04": {
   "pause": 1000,
   "voice": "james",
   "text": "Right, Diego. Your first time on the bridge at sea. Let me show you the equipment.",
   "es": "Bueno, Diego. Tu primera vez en el puente navegando. Te muestro los equipos."
  },
  "l13-05": {
   "voice": "diego",
   "text": "Great. Is this the radar?",
   "es": "Genial. ¿Esto es el radar?"
  },
  "l13-06": {
   "voice": "james",
   "text": "No, that's the ECDIS, the electronic chart. It shows our position. This one is the radar. It shows other ships.",
   "es": "No, eso es el ECDIS, la carta electrónica. Muestra nuestra posición. Este es el radar. Muestra otros buques."
  },
  "l13-07": {
   "voice": "diego",
   "text": "In fog too?",
   "es": "¿Con niebla también?"
  },
  "l13-08": {
   "voice": "james",
   "text": "In fog, at night, always. Remember Galveston?",
   "es": "Con niebla, de noche, siempre. ¿Te acordás de Galveston?"
  },
  "l13-09": {
   "voice": "diego",
   "text": "I do! And what does this do?",
   "es": "¡Sí! ¿Y esto para qué sirve?"
  },
  "l13-10": {
   "pause": 500,
   "voice": "james",
   "text": "That's the echo sounder. It measures the depth under the ship. Here, forty metres.",
   "es": "Es la ecosonda. Mide la profundidad debajo del buque. Acá, cuarenta metros."
  },
  "l13-11": {
   "voice": "diego",
   "text": "And the steering wheel?",
   "es": "¿Y el timón?"
  },
  "l13-12": {
   "voice": "james",
   "text": "We call it the helm. Now the autopilot steers, but we can change to hand steering any time.",
   "es": "Lo llamamos helm. Ahora gobierna el piloto automático, pero podemos pasar a gobierno manual cuando sea."
  },
  "l13-13": {
   "pause": 600,
   "voice": "james",
   "text": "This is the gyro compass. It gives the heading. And this lever is the engine telegraph.",
   "es": "Este es el girocompás. Da el rumbo de proa. Y esta palanca es el telégrafo de máquinas."
  },
  "l13-14": {
   "voice": "diego",
   "text": "And the binoculars?",
   "es": "¿Y los binoculares?"
  },
  "l13-15": {
   "voice": "james",
   "text": "For the lookout. But remember: the most important equipment on the bridge is your eyes.",
   "es": "Para la vigía. Pero acordate: el equipo más importante del puente son tus ojos."
  },
  "l13-16": {
   "voice": "diego",
   "text": "My eyes. Got it.",
   "es": "Mis ojos. Entendido."
  },
