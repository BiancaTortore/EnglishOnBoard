   "screens": [
    {
     "type": "tip",
     "tag": "Useful language",
     "title": "Asking about equipment",
     "list": [
      [
       "What does this do?",
       "¿Esto para qué sirve?",
       "p-whatdo"
      ],
      [
       "The radar shows other ships.",
       "El radar muestra otros buques.",
       "p-shows"
      ],
      [
       "The echo sounder measures the depth.",
       "La ecosonda mide la profundidad.",
