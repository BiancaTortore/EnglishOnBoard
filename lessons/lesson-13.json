 "audio": {
  "l13-01": {
   "voice": "lars",
   "text": "Forward, bridge. Stand by starboard anchor. Over.",
   "es": "Proa, puente. Listos con el ancla de estribor. Cambio.",
   "radio": true
  },
  "l13-02": {
   "voice": "tanya",
   "text": "Stand by starboard anchor. Forward, roger. Over.",
   "es": "Listos con el ancla de estribor. Proa, recibido. Cambio."
  },
  "l13-03": {
   "pause": 500,
   "voice": "tanya",
   "text": "Rolando, take off the lashing. Keep it on the brake. Diego, stand next to me and watch the chain.",
   "es": "Rolando, sacá la trinca. Dejala en el freno. Diego, ponete al lado mío y mirá la cadena."
  },
  "l13-04": {
   "voice": "diego",
   "text": "This fog… I can't see the water!",
   "es": "Esta niebla… ¡No veo el agua!"
  },
  "l13-05": {
   "voice": "tanya",
   "text": "That's why we anchor. The pilot boat can't come out in this fog, so the pilot stays with us.",
   "es": "Por eso fondeamos. Con esta niebla la lancha no puede salir a buscar al práctico, así que el práctico se queda con nosotros."
  },
  "l13-06": {
   "pause": 1300,
   "voice": "lars",
   "text": "Forward, bridge. Let go starboard anchor. Over.",
   "es": "Proa, puente. Fondo el ancla de estribor. Cambio.",
   "radio": true
  },
  "l13-07": {
   "voice": "tanya",
   "text": "Let go starboard anchor!",
   "es": "¡Fondo el ancla de estribor!"
  },
  "l13-08": {
   "voice": "rolando",
   "text": "Letting go!",
   "es": "¡Fondeando!"
  },
  "l13-09": {
   "pause": 1600,
   "voice": "tanya",
   "text": "Diego, how many shackles in the water?",
   "es": "Diego, ¿cuántos grilletes en el agua?"
  },
  "l13-10": {
   "pause": 700,
   "voice": "diego",
   "text": "Three shackles in the water.",
   "es": "Tres grilletes en el agua."
  },
  "l13-11": {
   "voice": "tanya",
   "text": "Good. And where is the chain leading?",
   "es": "Bien. ¿Y hacia dónde trabaja la cadena?"
  },
  "l13-12": {
   "pause": 600,
   "voice": "diego",
   "text": "It's leading… two o'clock.",
   "es": "Trabaja… hacia las dos."
  },
  "l13-13": {
   "voice": "tanya",
   "text": "Bridge, forward. Three shackles in the water, chain leading two o'clock. Over.",
   "es": "Puente, proa. Tres grilletes en el agua, cadena trabajando a las dos. Cambio."
  },
  "l13-14": {
   "pause": 700,
   "voice": "lars",
   "text": "Thank you. Report when the anchor is holding. Over.",
   "es": "Gracias. Avise cuando el ancla esté agarrando. Cambio.",
   "radio": true
  },
  "l13-15": {
   "pause": 2000,
   "voice": "tanya",
   "text": "Bridge, forward. The anchor is holding. Over.",
   "es": "Puente, proa. El ancla está agarrando. Cambio."
  },
  "l13-16": {
   "pause": 800,
   "voice": "tanya",
   "text": "Diego, now the fog bell. Ring it for five seconds, every minute.",
   "es": "Diego, ahora la campana de niebla. Tocala cinco segundos, cada minuto."
  },
  "l13-17": {
   "voice": "diego",
   "text": "Five seconds, every minute. OK, Chief.",
   "es": "Cinco segundos, cada minuto. Okey, jefa."
  },
