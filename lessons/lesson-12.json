  "l12-02": {
   "voice": "tanya",
   "text": "Stand by starboard anchor. Forward, roger. Over.",
   "es": "Listos con el ancla de estribor. Proa, recibido. Cambio."
  },
  "l12-03": {
   "pause": 500,
   "voice": "tanya",
   "text": "Rolando, take off the lashing. Keep it on the brake. Diego, stand next to me and watch the chain.",
   "es": "Rolando, sacá la trinca. Dejala en el freno. Diego, ponete al lado mío y mirá la cadena."
  },
  "l12-04": {
   "voice": "diego",
   "text": "This fog… I can't see the water!",
   "es": "Esta niebla… ¡No veo el agua!"
  },
  "l12-05": {
   "voice": "tanya",
   "text": "That's why we anchor. No entry to Galveston in this fog.",
   "es": "Por eso fondeamos. Con esta niebla no se entra a Galveston."
  },
  "l12-06": {
   "pause": 1300,
   "voice": "lars",
   "text": "Forward, bridge. Let go starboard anchor. Over.",
   "es": "Proa, puente. Fondo el ancla de estribor. Cambio.",
   "radio": true
  },
  "l12-07": {
   "voice": "tanya",
   "text": "Let go starboard anchor!",
   "es": "¡Fondo el ancla de estribor!"
  },
  "l12-08": {
   "voice": "rolando",
   "text": "Letting go!",
   "es": "¡Fondeando!"
  },
  "l12-09": {
   "pause": 1600,
   "voice": "tanya",
   "text": "Diego, how many shackles in the water?",
   "es": "Diego, ¿cuántos grilletes en el agua?"
  },
  "l12-10": {
   "pause": 700,
   "voice": "diego",
   "text": "Three shackles in the water.",
   "es": "Tres grilletes en el agua."
  },
  "l12-11": {
   "voice": "tanya",
   "text": "Good. And where is the chain leading?",
   "es": "Bien. ¿Y hacia dónde trabaja la cadena?"
  },
  "l12-12": {
   "pause": 600,
   "voice": "diego",
   "text": "It's leading… two o'clock.",
   "es": "Trabaja… hacia las dos."
  },
  "l12-13": {
   "voice": "tanya",
   "text": "Bridge, forward. Three shackles in the water, chain leading two o'clock. Over.",
   "es": "Puente, proa. Tres grilletes en el agua, cadena trabajando a las dos. Cambio."
  },
  "l12-14": {
   "pause": 700,
   "voice": "lars",
   "text": "Thank you. Report when the anchor is holding. Over.",
   "es": "Gracias. Avise cuando el ancla esté agarrando. Cambio.",
