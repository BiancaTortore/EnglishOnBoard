    "maindeck":   {"en": "main deck",     "ipa": "/meɪn dek/",       "es": "cubierta principal",        "audio": "w-maindeck",   "ex": "x-maindeck"},
    "tank":       {"en": "cargo tank",    "ipa": "/ˈkɑːɡəʊ tæŋk/",   "es": "tanque de carga",           "audio": "w-tank",       "ex": "x-tank"},
    "accom":      {"en": "accommodation", "ipa": "/əˌkɒməˈdeɪʃn/",   "es": "acomodación (habilitación)","audio": "w-accom",      "ex": "x-accom"},
    "bridge":     {"en": "bridge",        "ipa": "/brɪdʒ/",          "es": "puente",                    "audio": "w-bridge",     "ex": "x-bridge"},
    "funnel":     {"en": "funnel",        "ipa": "/ˈfʌnl/",          "es": "chimenea",                  "audio": "w-funnel",     "ex": "x-funnel"},
    "forecastle": {"en": "forecastle",    "ipa": "/ˈfəʊksl/",        "es": "castillo de proa",          "audio": "w-forecastle", "ex": "x-forecastle"},
    "mast":       {"en": "mast",          "ipa": "/mɑːst/",          "es": "mástil",                    "audio": "w-mast",       "ex": "x-mast"}
  },

