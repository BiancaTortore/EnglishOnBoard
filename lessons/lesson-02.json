  "docs": {
    "particulars": {
      "kind": "form",
      "title": "SHIP'S PARTICULARS",
      "subtitle": "M/V LNG HORIZON",
      "cells": [
        ["SHIP TYPE", "LNG carrier"],
        ["CARGO TANKS", "4, spherical (Moss)"],
        ["LENGTH OVERALL", "289 m"],
        ["BREADTH", "49 m"],
        ["ACCOMMODATION", "Aft, 6 decks"],
        ["BRIDGE", "Top of accommodation"],
        ["FORECASTLE", "Mooring winches, foremast"],
        ["CREW", "34"]
      ]
    }
