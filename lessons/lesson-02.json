{
  "n": 2,
  "module": 1,
  "title": "Parts of the ship",
  "place": "Day 1 · 09:00 · Houston, main deck",
  "goal": "Name the main parts of the ship and ask what something is called.",
  "images": {"hero": "img/l02/hero.jpg", "scene": "img/l02/scene.jpg"},

  "audio": {
    "l02-01": {"voice": "rolando", "text": "OK, this is the main deck. Leave your bag here for a minute.", "es": "Bueno, esta es la cubierta principal. Dejá tu bolso acá un minuto."},
    "l02-02": {"voice": "diego",   "text": "It's huge! Are those white spheres the cargo tanks?", "es": "¡Es enorme! ¿Esas esferas blancas son los tanques de carga?"},
    "l02-03": {"voice": "rolando", "text": "Yes, four cargo tanks. The LNG is inside, very, very cold.", "es": "Sí, cuatro tanques de carga. El GNL está adentro, muy, muy frío."},
    "l02-04": {"voice": "diego",   "text": "And the black part under the deck, that's the hull?", "es": "¿Y la parte negra debajo de la cubierta es el casco?"},
    "l02-05": {"voice": "rolando", "text": "That's right. The hull is the body of the ship.", "es": "Así es. El casco es el cuerpo del buque."},
    "l02-06": {"voice": "diego",   "text": "What's that tall white building, aft?", "es": "¿Qué es ese edificio blanco alto, a popa?"},
    "l02-07": {"voice": "rolando", "text": "That's the accommodation. Your cabin is in there, and the bridge is on top.", "es": "Es la acomodación. Tu camarote está ahí, y el puente está arriba de todo."},
    "l02-08": {"voice": "diego",   "text": "And behind the bridge, the chimney?", "es": "¿Y detrás del puente, la chimenea?"},
    "l02-09": {"voice": "rolando", "text": "Ha! On a ship it's called the funnel.", "es": "¡Ja! En un buque se llama funnel."},
    "l02-10": {"voice": "diego",   "text": "Funnel. OK. And what's that called, forward, at the bow?", "es": "Funnel. OK. ¿Y cómo se llama eso, a proa, en la proa?"},
    "l02-11": {"voice": "rolando", "text": "That's the forecastle. It's long when you write it, but we say it short: fo'c'sle. The mast is there too.", "es": "Es el castillo de proa. Se escribe largo, pero se dice corto: fo'c'sle. El mástil también está ahí."},
    "l02-12": {"voice": "diego",   "text": "Sorry, how do you say it again?", "es": "Perdón, ¿cómo se dice otra vez?"},
    "l02-13": {"voice": "rolando", "text": "Fo'c'sle. Don't worry, you'll hear it every day!", "es": "Fo'c'sle. Tranquilo, lo vas a escuchar todos los días."},

    "w-hull":       {"voice": "model", "text": "hull"},
    "w-maindeck":   {"voice": "model", "text": "main deck"},
    "w-tank":       {"voice": "model", "text": "cargo tank"},
    "w-accom":      {"voice": "model", "text": "accommodation"},
    "w-bridge":     {"voice": "model", "text": "bridge"},
    "w-funnel":     {"voice": "model", "text": "funnel"},
    "w-forecastle": {"voice": "model", "text": "forecastle"},
    "w-mast":       {"voice": "model", "text": "mast"},

    "x-hull":       {"voice": "model", "text": "The hull is black.", "es": "El casco es negro."},
    "x-maindeck":   {"voice": "model", "text": "Leave your bag on the main deck.", "es": "Dejá tu bolso en la cubierta principal."},
    "x-tank":       {"voice": "model", "text": "The ship has four cargo tanks.", "es": "El buque tiene cuatro tanques de carga."},
    "x-accom":      {"voice": "model", "text": "Your cabin is in the accommodation.", "es": "Tu camarote está en la acomodación."},
    "x-bridge":     {"voice": "model", "text": "The bridge is on top of the accommodation.", "es": "El puente está arriba de la acomodación."},
    "x-funnel":     {"voice": "model", "text": "The funnel is behind the bridge.", "es": "La chimenea está detrás del puente."},
    "x-forecastle": {"voice": "model", "text": "The forecastle is at the bow.", "es": "El castillo de proa está en la proa."},
    "x-mast":       {"voice": "model", "text": "The mast is on the forecastle.", "es": "El mástil está en el castillo de proa."},

    "p-called":     {"voice": "model", "text": "What's that called?", "es": "¿Cómo se llama eso?"},
    "p-itscalled":  {"voice": "model", "text": "It's called the funnel.", "es": "Se llama funnel."},
    "p-howsay":     {"voice": "model", "text": "How do you say it?", "es": "¿Cómo se dice?"},
    "p-isthat":     {"voice": "model", "text": "Is that the bridge?", "es": "¿Eso es el puente?"},

    "c-show-fcsle":  {"voice": "rolando", "text": "Show me the forecastle."},
    "c-show-mast":   {"voice": "rolando", "text": "Where's the mast?"},
    "c-show-accom":  {"voice": "rolando", "text": "Show me the accommodation."},
    "c-what-bow":    {"voice": "rolando", "text": "What's that, at the bow?"},
    "c-what-white":  {"voice": "rolando", "text": "What's that tall white building?"},
    "c-what-top":    {"voice": "rolando", "text": "What's on top of the accommodation?"},
    "c-show-funnel": {"voice": "tanya",   "text": "Show me the funnel."},
    "c-where-hull":  {"voice": "tanya",   "text": "Where's the hull?"},
    "c-mast-fcsle":  {"voice": "tanya",   "text": "The mast is on the forecastle."},
    "c-how-many":    {"voice": "tanya",   "text": "How many cargo tanks are there?"},
    "c-smoke":       {"voice": "tanya",   "text": "There's black smoke from the funnel."},

    "m-fcsle":      {"voice": "model", "text": "That's the forecastle.", "es": "Es el castillo de proa."},
    "m-accom":      {"voice": "model", "text": "That's the accommodation.", "es": "Es la acomodación."},
    "m-four":       {"voice": "model", "text": "There are four cargo tanks.", "es": "Hay cuatro tanques de carga."},
    "m-bridgetop":  {"voice": "model", "text": "The bridge is on top of the accommodation.", "es": "El puente está arriba de la acomodación."},
    "m-calledfcsle":{"voice": "model", "text": "It's called the forecastle.", "es": "Se llama castillo de proa."}
  },

  "dialogue": ["l02-01","l02-02","l02-03","l02-04","l02-05","l02-06","l02-07","l02-08","l02-09","l02-10","l02-11","l02-12","l02-13"],

  "words": {
