 "audio": {
  "l01-01": {
   "voice": "rolando",
   "text": "Good morning! Are you the new deck cadet?",
   "es": "¡Buen día! ¿Vos sos el nuevo cadete de cubierta?"
  },
  "l01-02": {
   "voice": "diego",
   "text": "Yes, good morning. I'm Diego Martínez.",
   "es": "Sí, buen día. Soy Diego Martínez."
  },
  "l01-03": {
   "voice": "rolando",
   "text": "I'm Rolando, the bosun. Welcome! This is the bow. The gangway is at the other end, so we have a little walk.",
   "es": "Soy Rolando, el contramaestre. ¡Bienvenido! Esta es la proa. La planchada está en la otra punta, así que nos toca caminar un poco."
  },
  "l01-04": {
   "voice": "rolando",
   "text": "The gangway is on the port side, aft.",
   "es": "La planchada está por babor, a popa."
  },
  "l01-05": {
   "voice": "diego",
   "text": "Sorry, can you say that again?",
   "es": "Perdón, ¿puede repetirlo?"
  },
  "l01-06": {
   "voice": "rolando",
   "text": "Port side. Aft. Near the stern. We're port side alongside, so this side is port.",
   "es": "Babor. A popa. Cerca de la popa. Estamos atracados por babor, así que este costado es babor."
  },
  "l01-07": {
   "voice": "diego",
   "text": "OK. So aft is towards the stern, and forward is towards the bow?",
   "es": "OK. ¿Entonces aft es hacia la popa y forward es hacia la proa?"
  },
  "l01-08": {
   "voice": "rolando",
   "text": "Exactly. Bow is forward, stern is aft.",
   "es": "Exacto. La proa está hacia forward, la popa hacia aft."
  },
  "l01-09": {
   "voice": "diego",
   "text": "She's very long. What's that, in the middle?",
   "es": "Es muy largo. ¿Qué es eso, en el medio?"
  },
  "l01-10": {
   "voice": "rolando",
   "text": "Amidships? That's the manifold. You'll see it a lot.",
   "es": "¿En el medio del buque? Es el manifold. Lo vas a ver mucho."
  },
  "l01-11": {
   "voice": "diego",
   "text": "And the starboard side is the other side, facing the water.",
   "es": "Y estribor es el otro costado, el que da al agua."
  },
  "l01-12": {
   "voice": "rolando",
   "text": "That's right. Here we are. The gangway. Watch your step!",
   "es": "Así es. Llegamos. La planchada. ¡Cuidado al subir!"
  },
