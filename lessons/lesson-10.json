    {
     "type": "tip",
     "tag": "Language focus",
     "title": "Now: am / is / are + -ing",
     "steps": [
      [
       "I",
       "I'm chipping."
      ],
      [
       "You / we / they",
       "We're lashing the drums."
      ],
      [
