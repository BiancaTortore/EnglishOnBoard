 "audio": {
  "l10-01": {
   "voice": "rolando",
   "text": "OK, cadet. We sail this afternoon, so we secure the deck for sea.",
   "es": "Bueno, cadete. Zarpamos esta tarde, así que trincamos la cubierta para navegar."
  },
  "l10-02": {
   "voice": "diego",
   "text": "Great. What are you doing?",
   "es": "Genial. ¿Qué estás haciendo?"
  },
  "l10-03": {
   "voice": "rolando",
   "text": "I'm lashing these drums. When the ship rolls, nothing moves. But first, your PPE. Here, take these gloves.",
   "es": "Estoy trincando estos tambores. Cuando el buque rola, no se mueve nada. Pero primero, tu equipo de protección. Tomá, estos guantes."
  },
  "l10-04": {
   "voice": "diego",
   "text": "Thanks. Can I help? I can finish the chipping here, with the hammer.",
   "es": "Gracias. ¿Te ayudo? Puedo terminar de picaretear acá, con el martillo."
  },
  "l10-05": {
   "pause": 700,
   "voice": "rolando",
   "text": "Stop! Where are your safety glasses?",
   "es": "¡Pará! ¿Dónde están tus antiparras?"
  },
  "l10-06": {
   "voice": "diego",
   "text": "Sorry. They're on my helmet.",
   "es": "Perdón. Están en el casco."
  },
  "l10-07": {
   "voice": "rolando",
   "text": "On your helmet they don't protect your eyes. Put them on. And your ear defenders. Chipping is very loud.",
   "es": "En el casco no te protegen los ojos. Ponételas. Y los protectores auditivos. Picaretear hace mucho ruido."
  },
  "l10-08": {
   "pause": 1000,
   "voice": "diego",
   "text": "OK. Glasses on, ear defenders on.",
   "es": "Listo. Antiparras puestas, protectores puestos."
  },
  "l10-09": {
   "voice": "rolando",
   "text": "Good. Now help me with the lashing. Can you pass me the spanner, please?",
   "es": "Bien. Ahora ayudame con la trinca. ¿Me pasás la llave, por favor?"
  },
  "l10-10": {
   "pause": 700,
   "voice": "diego",
   "text": "Here you are.",
   "es": "Acá tenés."
  },
  "l10-11": {
   "pause": 600,
   "voice": "rolando",
   "text": "Thanks. Not too tight… Good. Tomorrow we paint the mast. You come with me. For that you need a harness.",
   "es": "Gracias. No muy fuerte… Bien. Mañana pintamos el palo. Venís conmigo. Para eso necesitás un arnés."
  },
  "l10-12": {
   "voice": "diego",
   "text": "A harness? And a permit?",
   "es": "¿Un arnés? ¿Y un permiso?"
  },
  "l10-13": {
   "voice": "rolando",
   "text": "Yes. A work permit from the Chief Officer. No permit, no work.",
   "es": "Sí. Un permiso de trabajo de la Primer Oficial. Sin permiso, no se trabaja."
  },
  "l10-14": {
   "voice": "diego",
   "text": "No permit, no work. Got it.",
   "es": "Sin permiso, no se trabaja. Entendido."
  },
