    {
     "type": "tip",
     "tag": "Spanish speaker alert",
     "title": "\"No funciona\" = isn't working",
     "paras": [
      "<i>No funciona</i> → <b>It isn't working</b> (or <i>It doesn't work</i>). Not <i>It no works</i>.",
      "<i>Saltó la alarma</i> → <b>The alarm has gone off</b> / <b>went off</b>. <i>Se quemó el fusible</i> → <b>The fuse has blown</b>."
     ],
     "avoid": "It no works. · The alarm jumped. · The fuse burned."
    },
