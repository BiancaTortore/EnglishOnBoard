    },
    {
     "type": "tip",
     "tag": "Language focus",
     "title": "has stopped · isn't working · went off at…",
     "steps": [
      [
       "Result now",
       "The radar <b>has stopped</b>. A fuse <b>has blown</b>."
      ],
      [
       "State now",
       "The display <b>isn't working</b>."
      ],
      [
       "With a time",
       "The alarm <b>went off at</b> 0725."
      ]
     ],
     "paras": [
      "To report a fault you see <b>now</b>: <b>has / have</b> + past participle (<i>stopped, frozen, gone off, blown</i>), or <b>isn't working</b>.",
      "When you say <b>when</b> it happened, use the simple past: <i>It <b>stopped</b> at 0725.</i> Not <i>has stopped at</i>."
     ],
     "avoid": "The radar is stop. · It has stopped at 0725. · It don't work."
    },
    {
     "type": "choice",
     "q": "You see the screen: nothing moves. You report…",
     "opts": [
      "The display has frozen.",
      "The display is freeze.",
      "The display froze at."
     ],
     "a": 0
    },
    {
     "type": "choice",
     "q": "With the time: \"The alarm ___ off at 0725.\"",
     "opts": [
      "went",
      "has gone",
      "is going"
     ],
     "a": 0
    },
    {
     "type": "build",
     "situation": "Radar two is off and nothing works.",
     "q": "Report it.",
     "a": [
      "Radar",
      "two",
      "isn't",
      "working."
     ],
