 "audio": {
  "l06-01": {
   "voice": "diego",
   "text": "Good afternoon, Captain. I'm Diego Martínez, the new deck cadet.",
   "es": "Buenas tardes, Capitán. Soy Diego Martínez, el nuevo cadete de cubierta."
  },
  "l06-02": {
   "voice": "lars",
   "text": "Ah, the cadet! Come in, sit down. Welcome on board.",
   "es": "¡Ah, el cadete! Pasá, sentate. Bienvenido a bordo."
  },
  "l06-03": {
   "voice": "diego",
   "text": "Thank you, sir. The bosun said I sign on with you this afternoon.",
   "es": "Gracias, señor. El contramaestre me dijo que firmo el embarque con usted esta tarde."
  },
  "l06-04": {
   "voice": "lars",
   "text": "That's right. Is this your first ship?",
   "es": "Así es. ¿Es tu primer barco?"
  },
  "l06-05": {
   "voice": "diego",
   "text": "Yes, it's my first ship.",
   "es": "Sí, es mi primer barco."
  },
  "l06-06": {
   "voice": "lars",
   "text": "Everybody has a first ship. OK, this is the crew agreement. Your passport and your seaman's book, please.",
   "es": "Todos tienen un primer barco. Bueno, este es el rol. Tu pasaporte y tu libreta de embarco, por favor."
  },
  "l06-07": {
   "voice": "diego",
   "text": "Here you are.",
   "es": "Acá tiene."
  },
  "l06-08": {
   "voice": "lars",
   "text": "So, you're joining as deck cadet. Your surname… how do you spell it?",
   "es": "Entonces embarcás como cadete de cubierta. Tu apellido… ¿cómo se deletrea?"
  },
  "l06-09": {
   "voice": "diego",
   "text": "Mike, Alfa, Romeo, Tango, India, November, Echo, Zulu. Martínez.",
   "es": "M-A-R-T-I-N-E-Z. Martínez."
  },
  "l06-10": {
   "voice": "lars",
   "text": "With a Z. Good. Nationality, Argentine. Date of birth… the twelfth of August, two thousand and four.",
   "es": "Con Z. Bien. Nacionalidad, argentina. Fecha de nacimiento… doce de agosto de dos mil cuatro."
  },
  "l06-11": {
   "voice": "diego",
   "text": "Sorry, Captain. Two thousand and three.",
   "es": "Perdón, Capitán. Dos mil tres.",
   "note": "Stress on THREE: he is correcting the Captain."
  },
  "l06-12": {
   "voice": "lars",
   "text": "Three. You're right, I need new glasses. Now, your seaman's book number. Read it to me, please.",
   "es": "Tres. Tenés razón, necesito anteojos nuevos. Ahora, el número de tu libreta. Leémelo, por favor."
  },
  "l06-13": {
   "voice": "diego",
   "text": "Alfa Romeo, zero, four, seven, nine, two, six.",
   "es": "A-R, cero, cuatro, siete, nueve, dos, seis."
  },
  "l06-14": {
   "voice": "lars",
   "text": "AR zero four seven nine two six. Good. Sign here, please.",
   "es": "AR cero cuatro siete nueve dos seis. Bien. Firmá acá, por favor."
  },
  "l06-15": {
   "voice": "diego",
   "text": "Here?",
   "es": "¿Acá?"
  },
  "l06-16": {
   "voice": "lars",
   "text": "Yes, next to your name. Right, you're signed on. The Chief Officer will meet you in your cabin later, for your safety kit.",
   "es": "Sí, al lado de tu nombre. Listo, ya estás enrolado. La Primera Oficial te va a ver en tu camarote más tarde, por tu equipo de seguridad."
  },
  "l06-17": {
   "voice": "diego",
   "text": "Thank you, Captain.",
   "es": "Gracias, Capitán."
  },
