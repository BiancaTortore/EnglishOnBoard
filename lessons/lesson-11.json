 "audio": {
  "l11-01": {
   "voice": "rolando",
   "text": "Cadet! The stores truck is here. We load everything with the provision crane.",
   "es": "¡Cadete! Llegó el camión de víveres. Subimos todo con la grúa de provisiones."
  },
  "l11-02": {
   "voice": "diego",
   "text": "With the crane? Can I help?",
   "es": "¿Con la grúa? ¿Te ayudo?"
  },
  "l11-03": {
   "voice": "rolando",
   "text": "Yes. I'm in the crane, you're the signalman. You watch the load and give me the signals.",
   "es": "Sí. Yo voy en la grúa, vos sos el señalero. Mirás la carga y me hacés las señales."
  },
  "l11-04": {
   "pause": 900,
   "voice": "tanya",
   "text": "Diego, before the first lift, check the gear: the sling, the shackle and the hook.",
   "es": "Diego, antes del primer izado, revisá el equipo: la eslinga, el grillete y el gancho."
  },
  "l11-05": {
   "pause": 800,
   "voice": "diego",
   "text": "Sling on the hook, shackle pin tight. Ready.",
   "es": "Eslinga en el gancho, perno del grillete ajustado. Listo."
  },
  "l11-06": {
   "voice": "rolando",
   "text": "OK, cadet. Give me the signals.",
   "es": "Bien, cadete. Haceme las señales."
  },
  "l11-07": {
   "pause": 600,
   "voice": "diego",
   "text": "Hoist slowly… Stop!",
   "es": "Izá despacio… ¡Pará!"
  },
  "l11-08": {
   "voice": "rolando",
   "text": "Where does it go?",
   "es": "¿Dónde va?"
  },
  "l11-09": {
   "pause": 600,
   "voice": "diego",
   "text": "Slew left… Stop. Lower… lower… Stop. Load on deck.",
   "es": "Girá a la izquierda… Pará. Arriá… arriá… Pará. Carga en cubierta."
  },
  "l11-10": {
   "pause": 1000,
   "voice": "mario",
   "text": "Careful! My eggs are in that pallet!",
   "es": "¡Cuidado! ¡Mis huevos están en ese pallet!"
  },
  "l11-11": {
   "voice": "rolando",
   "text": "Relax, Mario. Cadet, now we lash it. Lashings on, turnbuckles tight.",
   "es": "Tranquilo, Mario. Cadete, ahora lo trincamos. Trincas puestas, tensores ajustados."
  },
  "l11-12": {
   "pause": 900,
   "voice": "diego",
   "text": "Lashings on, turnbuckles tight. Nothing moves.",
   "es": "Trincas puestas, tensores ajustados. No se mueve nada."
  },
  "l11-13": {
