 "audio": {
  "l28-01": {
   "voice": "lars",
   "text": "Good morning, cadet. This morning you're on the engine telegraph. Repeat every engine order, loud and clear.",
   "es": "Buen día, cadete. Esta mañana vas al telégrafo de máquina. Repetí cada orden de máquina, fuerte y claro."
  },
  "l28-02": {
   "voice": "diego",
   "text": "Yes, Captain.",
   "es": "Sí, Capitán."
  },
  "l28-03": {
   "pause": 900,
   "voice": "lars",
   "text": "Engine room, bridge. Stand by engine. Pilot at seven.",
   "es": "Máquinas, puente. Máquina en atención. Práctico a las siete."
  },
  "l28-04": {
   "pause": 1200,
   "voice": "marek",
   "text": "Bridge, engine room. Standing by. Engine tested ahead and astern. Rudder tested, hard over both sides. All OK.",
   "es": "Puente, máquinas. En atención. Máquina probada avante y atrás. Timón probado, todo a una y otra banda. Todo bien."
  },
  "l28-05": {
   "voice": "lars",
   "text": "Thank you, Chief. Half ahead.",
   "es": "Gracias, Jefe. Adelante media."
  },
  "l28-06": {
   "pause": 1300,
   "voice": "diego",
   "text": "Half ahead.",
   "es": "Adelante media."
  },
  "l28-07": {
   "voice": "diego",
   "text": "Engine is half ahead.",
   "es": "Máquina adelante media."
  },
  "l28-08": {
   "pause": 1500,
   "voice": "lars",
   "text": "Slow ahead.",
   "es": "Adelante despacio."
  },
  "l28-09": {
   "pause": 1300,
   "voice": "diego",
   "text": "Slow ahead.",
   "es": "Adelante despacio."
  },
  "l28-10": {
   "voice": "diego",
   "text": "Engine is slow ahead. Captain, why so slow?",
   "es": "Máquina adelante despacio. Capitán, ¿por qué tan despacio?"
  },
  "l28-11": {
   "voice": "lars",
   "text": "The pilot boat comes alongside at about eight knots. We need to be slow and steady.",
   "es": "La lancha del práctico se abarloa a unos ocho nudos. Tenemos que ir despacio y firmes."
  },
  "l28-12": {
   "pause": 1000,
   "voice": "tanya",
   "text": "Morning, Captain. The berthing plan from the port: two tugs. One will make fast forward, one aft.",
   "es": "Buen día, Capitán. El plan de atraque del puerto: dos remolcadores. Uno toma cabo a proa y otro a popa."
  },
  "l28-13": {
   "voice": "lars",
   "text": "Good. Our lines will go on their towing hooks. Port side alongside, on the big fenders of the gas berth.",
   "es": "Bien. Nuestros cabos van a ir a sus ganchos de remolque. Atracamos por babor, contra las defensas grandes del muelle de gas."
  },
  "l28-14": {
   "pause": 1500,
   "voice": "lars",
   "text": "Dead slow ahead.",
   "es": "Adelante muy despacio."
  },
  "l28-15": {
   "pause": 1300,
   "voice": "diego",
   "text": "Dead slow ahead.",
   "es": "Adelante muy despacio."
  },
  "l28-16": {
   "voice": "diego",
   "text": "Engine is dead slow ahead.",
   "es": "Máquina adelante muy despacio."
  },
  "l28-17": {
   "pause": 900,
   "voice": "lars",
   "text": "Good. In one hour, the pilot. And then, cadet, you take the wheel.",
   "es": "Bien. En una hora, el práctico. Y después, cadete, tomás el timón."
  },
  "l28-18": {
   "pause": 600,
   "voice": "diego",
   "text": "The wheel? Me?",
   "es": "¿El timón? ¿Yo?"
  },
  "l28-19": {
   "voice": "tanya",
   "text": "You. Steady hands, Diego.",
   "es": "Vos. Manos firmes, Diego."
  },
