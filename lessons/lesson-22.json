  "l22-02": {
   "pause": 900,
   "voice": "rolando",
   "text": "Man overboard, starboard side! I see it!",
   "es": "¡Hombre al agua por estribor! ¡Lo veo!"
  },
  "l22-03": {
   "pause": 700,
   "voice": "tanya",
   "text": "Diego, you will be the lookout. Keep pointing at him and don't look away.",
   "es": "Diego, vos vas a ser el vigía. Seguí señalándolo y no le saques la vista de encima."
  },
  "l22-04": {
   "voice": "diego",
   "text": "I'll keep pointing. He's there, about two hundred metres, starboard quarter!",
   "es": "Lo sigo señalando. ¡Está ahí, a unos doscientos metros, por la aleta de estribor!"
  },
  "l22-05": {
   "voice": "tanya",
   "text": "Rolando, you will throw the lifebuoy with the smoke float.",
   "es": "Rolando, vos vas a tirar el aro salvavidas con la señal fumígena."
  },
  "l22-06": {
   "pause": 1200,
   "voice": "rolando",
   "text": "Lifebuoy and smoke float, gone!",
   "es": "¡Aro y señal fumígena, tirados!"
  },
  "l22-07": {
   "voice": "tanya",
   "text": "Bridge, starboard side. Lookout on the casualty, lifebuoy in the water. Over.",
   "es": "Puente, banda de estribor. Vigía sobre el náufrago, aro en el agua. Cambio."
  },
  "l22-08": {
   "pause": 600,
   "voice": "lars",
   "text": "Received. MOB button pressed. I'm turning to starboard. Rescue boat crew, stand by. Over.",
   "es": "Recibido. Botón de hombre al agua apretado. Caigo a estribor. Tripulación del bote de rescate, listos. Cambio.",
   "radio": true
  },
  "l22-09": {
   "pause": 1500,
   "voice": "diego",
   "text": "I can still see him. Now he's on the starboard beam!",
   "es": "¡Lo sigo viendo! ¡Ahora está por el través de estribor!"
  },
  "l22-10": {
   "voice": "tanya",
   "text": "Good, Diego. Keep him in sight. If you lose him, say so at once.",
   "es": "Bien, Diego. Mantenelo a la vista. Si lo perdés, decilo enseguida."
