 "audio": {
  "l22-01": {
   "voice": "tanya",
   "text": "Weekly inspection of the life-saving appliances. We start with the liferafts.",
   "es": "Inspección semanal de los elementos salvavidas. Empezamos con las balsas."
  },
  "l22-02": {
   "voice": "diego",
   "text": "How many liferafts are there on this side?",
   "es": "¿Cuántas balsas hay de este lado?"
  },
  "l22-03": {
   "voice": "tanya",
   "text": "Two, in their cradles. If the ship sinks, the hydrostatic release lets them go and they inflate by themselves.",
   "es": "Dos, en sus soportes. Si el buque se hunde, la zafa hidrostática las suelta y se inflan solas."
  },
  "l22-04": {
   "voice": "diego",
   "text": "And the painter?",
   "es": "¿Y la boza?"
  },
  "l22-05": {
   "voice": "tanya",
   "text": "The painter is the line from the raft to the ship. Check that it's connected.",
   "es": "La boza es el cabo de la balsa al buque. Fijate que esté conectada."
  },
  "l22-06": {
   "pause": 800,
   "voice": "diego",
   "text": "Connected. And this is the davit, for launching the other raft.",
   "es": "Conectada. Y este es el pescante, para arriar la otra balsa."
  },
  "l22-07": {
   "voice": "tanya",
   "text": "Right. Now the lifebuoy with light and smoke. And the EPIRB on the bridge wing.",
   "es": "Bien. Ahora el aro salvavidas con luz y humo. Y la radiobaliza en el alerón."
  },
  "l22-08": {
   "pause": 1200,
   "voice": "diego",
   "text": "The EPIRB: green light, it's OK. What does it do exactly?",
   "es": "La radiobaliza: luz verde, está bien. ¿Qué hace exactamente?"
  },
  "l22-09": {
   "voice": "tanya",
   "text": "When it's activated, it sends our position by satellite. The SART shows us on other ships' radar.",
   "es": "Cuando se activa, manda nuestra posición por satélite. El SART nos muestra en el radar de otros buques."
  },
  "l22-10": {
   "pause": 600,
   "voice": "tanya",
   "text": "Last thing: the flares. Check the expiry dates.",
   "es": "Lo último: las bengalas. Revisá las fechas de vencimiento."
  },
  "l22-11": {
   "pause": 1500,
   "voice": "diego",
   "text": "Chief, this flare has expired. The expiry date was January.",
   "es": "Jefa, esta bengala está vencida. La fecha de vencimiento era enero."
  },
  "l22-12": {
   "voice": "tanya",
   "text": "Well spotted. Write it on the checklist and take it to the store. We'll order a new one.",
   "es": "Bien visto. Anotalo en la lista y llevala al pañol. Pedimos una nueva."
  },
  "l22-13": {
   "voice": "diego",
   "text": "Expired flare, written down.",
   "es": "Bengala vencida, anotada."
  },
