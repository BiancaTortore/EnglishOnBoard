  "l14-01": {
   "voice": "tanya",
   "text": "Good morning, James. Diego, this is your first night watch. Listen to the handover.",
   "es": "Buen día, James. Diego, esta es tu primera guardia de noche. Escuchá el relevo."
  },
  "l14-02": {
   "voice": "james",
   "text": "Morning, both. OK. Course one one zero, speed sixteen knots, on autopilot.",
   "es": "Buen día a los dos. Bueno. Rumbo uno uno cero, velocidad dieciséis nudos, en piloto automático."
  },
  "l14-03": {
   "voice": "tanya",
   "text": "Course one one zero, speed sixteen.",
   "es": "Rumbo uno uno cero, velocidad dieciséis."
  },
  "l14-04": {
   "pause": 500,
   "voice": "james",
   "text": "Position: about ninety miles south of the Mississippi. It's on the chart.",
   "es": "Posición: unas noventa millas al sur del Mississippi. Está en la carta."
  },
  "l14-05": {
   "voice": "james",
   "text": "Traffic: one fishing boat on the port bow, eight miles. No danger.",
   "es": "Tráfico: un pesquero por la amura de babor, a ocho millas. Sin peligro."
  },
  "l14-06": {
   "voice": "james",
   "text": "Weather: wind north-west, force four. A front is coming in the morning.",
   "es": "Tiempo: viento del noroeste, fuerza cuatro. Viene un frente a la mañana."
  },
  "l14-07": {
   "voice": "tanya",
   "text": "And the Captain's night orders?",
   "es": "¿Y las órdenes de noche del Capitán?"
  },
  "l14-08": {
   "pause": 400,
   "voice": "james",
   "text": "Call him if visibility is less than three miles, or if any ship comes closer than two miles.",
   "es": "Llamarlo si la visibilidad baja de tres millas, o si algún buque se acerca a menos de dos millas."
  },
  "l14-09": {
   "voice": "tanya",
   "text": "Under three miles, closer than two miles. OK.",
   "es": "Menos de tres millas, menos de dos millas. Okey."
  },
  "l14-10": {
   "pause": 800,
   "voice": "diego",
   "text": "And the lookout? Is that me?",
   "es": "¿Y la vigía? ¿Soy yo?"
  },
  "l14-11": {
   "voice": "tanya",
   "text": "Yes. You're the lookout. Eyes outside, and report everything you see.",
   "es": "Sí. Vos sos la vigía. Ojos afuera, y reportá todo lo que veas."
  },
  "l14-12": {
   "pause": 600,
   "voice": "james",
   "text": "Any questions, Tanya?",
   "es": "¿Alguna pregunta, Tanya?"
  },
  "l14-13": {
   "voice": "tanya",
   "text": "No questions. I have the watch.",
   "es": "Sin preguntas. Tomo la guardia."
  },
  "l14-14": {
   "pause": 500,
   "voice": "james",
   "text": "You have the watch. Good night.",
   "es": "La guardia es tuya. Buenas noches."
  },
