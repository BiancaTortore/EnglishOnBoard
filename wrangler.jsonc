// Cloudflare deploy config. The repo is a static site (no build step) with a small
// worker in front for /api/* and /admin (feedback, anonymous progress, admin page).
// Secrets set in the Cloudflare dashboard (never in this file): FEEDBACK_TO, ADMIN_PIN.
{
  "name": "englishonboard",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/admin", "/admin/"]
  },
  "send_email": [
    { "name": "EMAIL" }
  ]
  // KV for comments and usage: add once the namespace exists in the dashboard
  // "kv_namespaces": [ { "binding": "DATA", "id": "<namespace id>" } ]
}
