// Cloudflare deploy config. The repo is a static site (no build step) with a small
// worker in front for /api/* and /admin (feedback, anonymous progress, admin page).
// Secrets set in the Cloudflare dashboard (never in this file): FEEDBACK_TO, ADMIN_PIN,
// RESEND_KEY (accounts).
{
  "name": "englishonboard",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*", "/admin", "/admin/", "/verify", "/verify/", "/lessons/*", "/audio/*"]
  },
  // plain settings (not secret). Kept here because a deploy replaces what was typed in the dashboard.
  "vars": {
    "MAIL_FROM": "English on Board <login@chartroomlab.com>",
    // accounts that always see the whole course
    "AUTHOR_EMAILS": "biantortore@gmail.com",
    "GOOGLE_CLIENT_ID": "964654618857-mpmm8oq9jot1cpijrgcjetqo0e4don6p.apps.googleusercontent.com"
  },
  "send_email": [
    { "name": "EMAIL" }
  ],
  // KV namespace "englishonboard-data": comments and anonymous usage
  "kv_namespaces": [
    { "binding": "DATA", "id": "8bb14d2108d84b769844d50507be255d" }
  ]
}
